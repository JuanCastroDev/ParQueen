# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
functions/.env

# Service account keys — must never be committed
*service-account*.json
*serviceAccount*.json
*service_account*.json

# Generated caches
.firebase/
firebase-debug.log
**/__pycache__/
**/*.pyc
.claude/settings.local.json

# Generated test output and local audit worktrees (previously only in
# .git/info/exclude, which is local-only and not shared with clones)
test-results/
.audit-worktrees/

# Capacitor / native local artifacts (Phase 1+)
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.keystore
android/app/*.jks
ios/App/Pods/
ios/App/Podfile.lock
ios/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
# Firebase native config files are added in later phases — never commit secrets
GoogleService-Info.plist
google-services.json
**/GoogleService-Info.plist
**/google-services.json
*.mobileprovision
*.p12
*.cer

# Regenerated by npm run cap:sync / npx cap copy — do not review as source
android/app/src/main/assets/public/
ios/App/App/public/

# Waitlist migration exports contain personal data. Keep the Squarespace export
# (the migration backup) outside the repository; never commit it.
*squarespace*export*.csv
*waitlist*export*.csv
functions/scripts/*.csv
