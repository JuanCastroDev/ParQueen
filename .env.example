# Mandatory for every production client build (web, PWA, and Capacitor Android
# web assets). Any `vite build` (including `--mode staging`) fails if this is missing, empty,
# or whitespace-only. Runtime code still refuses a blank token as well.
VITE_MAPBOX_TOKEN=

# Optional. Web/PWA App Check reCAPTCHA Enterprise site key.
# Capacitor Android and iOS use native App Check bridges instead (Play
# Integrity / Debug on Android; App Attest on iOS).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Development/debug only. Never required for production builds.
VITE_APPCHECK_DEBUG_TOKEN=

# Client-visible — safe to embed. Enables production error monitoring; a
# missing value simply leaves it disabled (see utils/sentryInit.ts).
VITE_SENTRY_DSN=

# Build-time only — read via Vite's loadEnv in vite.config.ts, never exposed
# to client code. All three are required together for the Sentry Vite plugin
# to upload source maps; leaving any of them unset produces an ordinary
# build with no source maps generated at all (see sentryRelease.ts).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
