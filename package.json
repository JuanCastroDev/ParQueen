{
  "name": "parqueen",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules:unit": "vitest run --config vite.rules.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-parkqueen-rules-test \"npm run test:rules:unit\"",
    "test:storage:rules:unit": "vitest run --config vite.storage-rules.config.ts",
    "test:storage:rules": "firebase emulators:exec --only storage \"npm run test:storage:rules:unit\"",
    "install:functions": "npm install --prefix functions",
    "test:functions": "firebase emulators:exec --only functions,firestore,auth,storage \"vitest run --config vite.functions.config.ts\"",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npm run build && npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/ios": "^8.5.2",
    "@sentry/react": "^10.72.0",
    "firebase": "^10.8.0",
    "firebase-admin": "^13.6.1",
    "geofire-common": "^6.0.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^0.344.0",
    "mapbox-gl": "^3.18.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^2.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.0.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.5",
    "esbuild": "0.28.1",
    "react-test-renderer": "^18.2.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.1.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "undici": "^6.28.1"
  },
  "private": true
}
