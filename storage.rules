rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // JPEG, PNG, WebP only — SVG/GIF/TIFF/BMP and all other image/* subtypes rejected.
    // Magic-byte validation and EXIF stripping are performed server-side by
    // the moderateAvatarUpload Cloud Function via Sharp.
    function isValidAvatarUpload() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Upload quarantine — owner may only CREATE the "original" file.
    // Exactly two Firestore accesses, on two documents, with no repeated
    // access and no cache assumption:
    //   1. exists(accountLifecycle/{uid})
    //   2. get(users/{uid})
    // A missing user document makes get() fail the evaluation, which denies
    // the upload. Account onboarding does not use this rule. A present
    // profile denies when status is Suspended or productAccessBlocked is
    // present and not exactly boolean false, including malformed values.
    function deletionFenced(uid) {
      return firestore.exists(/databases/(default)/documents/accountLifecycle/$(uid));
    }
    function uploadProfileDenies(uid) {
      let profile = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return profile.get('status', '') == 'Suspended'
        || profile.get('productAccessBlocked', false) != false;
    }

    match /avatarUploads/{uid}/{uploadId}/original {
      allow create: if isOwner(uid)
        && isValidAvatarUpload()
        && !deletionFenced(uid)
        && !uploadProfileDenies(uid);
      allow update, delete, read: if false;
    }
    // Any other filename under the upload quarantine is denied entirely.
    match /avatarUploads/{uid}/{uploadId}/{fileName} {
      allow read, write, delete: if false;
    }

    // Processed candidates — server-only; no client access at any time.
    // Vision SafeSearch scans the candidate before it is published to avatars/.
    match /avatarCandidates/{allPaths=**} {
      allow read, write: if false;
    }

    // Published avatar — written server-side after moderation approval.
    // Owner can read their own published avatar; client cannot write or delete.
    match /avatars/{uid} {
      allow read:   if isOwner(uid) && !deletionFenced(uid);
      allow write, delete: if false;
    }

    // Subdirectory variant kept for forward-compatibility with future avatar sizes.
    match /avatars/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid) && !deletionFenced(uid);
      allow write, delete: if false;
    }

    // Default: deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
