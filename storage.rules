rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // JPEG, PNG, WebP only — SVG/GIF/TIFF/BMP and all other image/* subtypes rejected.
    // Magic-byte validation and EXIF stripping are performed server-side by
    // the moderateAvatarUpload Cloud Function via Sharp.
    function isValidAvatarUpload() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Upload quarantine — owner may only CREATE the "original" file; no overwrites.
    // Enforced: owner auth, MIME type, 5 MB size limit, create-only (no update),
    // and the same user-document access policy as Firestore.
    //
    // One firestore.exists/get of users/{uid} in the default database.
    // status == 'Suspended' denies. productAccessBlocked denies unless the
    // field is missing or exactly boolean false. pendingUploadId freshness
    // stays in moderateAvatarUpload.
    function avatarUploadDenied(uid) {
      let userPath = /databases/(default)/documents/users/$(uid);
      return firestore.exists(userPath) && (
        firestore.get(userPath).data.get('status', '') == 'Suspended'
        || firestore.get(userPath).data.get('productAccessBlocked', false) != false
      );
    }

    match /avatarUploads/{uid}/{uploadId}/original {
      allow create: if isOwner(uid)
        && isValidAvatarUpload()
        && !avatarUploadDenied(uid);
      allow update, delete, read: if false;
    }
    // Any other filename under the upload quarantine is denied entirely.
    match /avatarUploads/{uid}/{uploadId}/{fileName} {
      allow read, write, delete: if false;
    }

    // Processed candidates — server-only; no client access at any time.
    // Vision SafeSearch scans the candidate before it is published to avatars/.
    match /avatarCandidates/{allPaths=**} {
      allow read, write: if false;
    }

    // Published avatar — written server-side after moderation approval.
    // Owner can read their own published avatar; client cannot write or delete.
    match /avatars/{uid} {
      allow read:   if isOwner(uid);
      allow write, delete: if false;
    }

    // Subdirectory variant kept for forward-compatibility with future avatar sizes.
    match /avatars/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid);
      allow write, delete: if false;
    }

    // Default: deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
