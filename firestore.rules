 rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // isAdmin() (token-only `request.auth.token.role == 'admin'`) has been
    // removed entirely. Firestore Rules cannot re-verify current server-side
    // Auth state, so a token-only admin check can never safely reject a
    // demoted/deleted/disabled administrator's still-valid ID token — Rules
    // is structurally the wrong layer for that authorization. Every
    // admin-only read/write in this file is now either genuinely public
    // (`true`) or routed through a requireCurrentAdmin-gated Cloud Function
    // callable (functions/adminAuth.js), which re-derives authorization from
    // live Auth state on every call. Do not reintroduce a token-only admin
    // check here — add a callable instead.

    // ── Spot update helpers ───────────────────────────────────────────────────
    function isFinder() {
      return resource.data.finderId == request.auth.uid;
    }

    function isClaimer() {
      return resource.data.interestedUserId == request.auth.uid;
    }

    function isHoldClaimer() {
      return resource.data.claimedBy == request.auth.uid;
    }

    function isAvailableForClaim() {
      return resource.data.status == 'available'
        && resource.data.get('interestedUserId', null) == null
        && resource.data.get('holdRequestedBy', null) == null;
    }

    function isAvailableForHold() {
      return resource.data.status == 'available'
        && resource.data.get('interestedUserId', null) == null
        && resource.data.get('holdRequestedBy', null) == null;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Spot identity-display authority: finderName/finderTitle/finderVehicle*
    // (and the interestedUser/holdRequestedBy equivalents) are cached copies
    // of the caller's own profile, written directly by the client at
    // create/claim/hold-request time with no live re-fetch on render — unlike
    // chats/{chatId}'s (now-removed) participantNames, nothing corrects a
    // forged value later. These helpers require every such field to exactly
    // match the caller's own CURRENT profile at write time, closing the
    // forgery/impersonation gap while keeping every legitimate write
    // (which already derives these values from the live profile) unaffected.
    // See docs/SPOT_METADATA_HARDENING.md.
    function expectedDisplayName(profile) {
      return profile.get('username', null) != null
        ? profile.username
        : (profile.get('fullName', null) != null ? profile.fullName : 'Anonymous');
    }

    // Mirrors utils/crowns.ts's TITLE_THRESHOLDS/getTitleForCrowns exactly —
    // keep in sync if those thresholds ever change.
    function titleForCrowns(crowns) {
      return crowns >= 3000 ? 'Urban Legend'
        : crowns >= 1500 ? 'Parking Veteran'
        : crowns >= 750 ? 'Block Captain'
        : crowns >= 400 ? 'Parking Expert'
        : crowns >= 150 ? 'Neighborhood Guide'
        : crowns >= 50 ? 'Street Scout'
        : crowns >= 10 ? 'Trusted Driver'
        : 'Newcomer';
    }

    // finderTitle/finderVehicle* (and their interestedUser/holdRequestedBy
    // equivalents below) are OPTIONAL create/update fields — a legitimate
    // write may omit any of them entirely (e.g. a user with no vehicle set
    // sends no finderVehicleColor key at all, not a null value). Each check
    // is therefore "if present, must match the live profile" rather than
    // "must always be present" — required fields (finderName etc.) are
    // required by the surrounding hasAll()/onlyChanges() checks already,
    // not by these helpers.
    function matchesFinderIdentity(data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (!('finderName' in data) || data.finderName == expectedDisplayName(profile))
        && (!('finderTitle' in data) || data.finderTitle == titleForCrowns(profile.get('crowns', 0)))
        && (!('finderVehicleColor' in data) || data.finderVehicleColor == profile.get('vehicleColor', null))
        && (!('finderVehicleType' in data) || data.finderVehicleType == profile.get('vehicleType', null))
        && (!('finderVehicleBrand' in data) || data.finderVehicleBrand == profile.get('vehicleBrand', null));
    }

    function matchesInterestedUserIdentity(data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (!('interestedUserName' in data) || data.interestedUserName == expectedDisplayName(profile))
        && (!('interestedUserTitle' in data) || data.interestedUserTitle == titleForCrowns(profile.get('crowns', 0)))
        && (!('interestedUserVehicleColor' in data) || data.interestedUserVehicleColor == profile.get('vehicleColor', null))
        && (!('interestedUserVehicleType' in data) || data.interestedUserVehicleType == profile.get('vehicleType', null))
        && (!('interestedUserVehicleBrand' in data) || data.interestedUserVehicleBrand == profile.get('vehicleBrand', null));
    }

    function matchesHoldRequesterIdentity(data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !('holdRequestedByName' in data) || data.holdRequestedByName == expectedDisplayName(profile);
    }

    function chatParticipant(chatData) {
      return signedIn()
        && request.auth.uid in chatData.participants;
    }

    match /users/{userId} {
      // isAdmin() removed from this OR-chain: it was redundant, not
      // protective — signedIn() alone already grants read access to every
      // signed-in user regardless of role (pre-existing, unrelated to admin
      // session hardening; not a capability change). The Admin Dashboard's
      // bulk/cross-user consumption of this collection (UsersPage.tsx) now
      // goes through the requireCurrentAdmin-gated adminReadView callable
      // instead, which is a genuine hardening improvement over the previous
      // any-signed-in-user-capable direct query.
      // Phase A: stop client directory enumeration. Keep signed-in get-by-id
      // (MessagesView). Deny list/query. Admin bulk reads use Admin SDK.
      // Approach B (narrow peer projection) is a separate follow-up.
      allow get: if signedIn();
      allow list: if false;
      // Direct client CREATE disabled — claimUsername (functions/index.js) is
      // now the sole authoritative writer of the initial users/{uid} doc
      // (including its private/social and private/preferences siblings),
      // atomically with the username reservation. No client path creates
      // this document directly anymore (confirmed by repo-wide audit — the
      // former saveUserProfile() create path has been retired). See
      // docs/PROFILE_IDENTITY_HARDENING.md.
      allow create: if false;
      // Direct admin writes removed: no admin client code ever exercised this
      // branch (all admin mutations of user state go through callables —
      // setStaffRole, adminSuspendUser/adminUnsuspendUser), and Rules cannot
      // re-verify current server-side Auth state the way requireCurrentAdmin
      // does, so an unrestricted isAdmin() write here would let a stale
      // admin token mutate any field (including crowns/title) directly.
      //
      // username/fullName removed from this allowlist — claimUsername and
      // updateDisplayName are now the sole authoritative writers of those
      // two identity fields (Admin SDK writes bypass these Rules entirely).
      // An ordinary owner update touching either field is denied outright,
      // even alongside otherwise-legitimate unrelated field changes.
      allow update: if signedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   // Vehicle
                   'vehicleType', 'vehicleBrand', 'vehicleColor',
                   // Avatar
                   'avatarUrl', 'avatarManifestId', 'avatarAgeGroup', 'avatarUpdatedAt',
                 ]);
      allow delete: if false;

      match /processedTrustEvents/{eventId} {
        allow read, write: if false;
      }

      // private/avatar — client writes pendingUploadId before each upload attempt.
      // Server clears the record on successful publication. Strict field schema.
      match /private/avatar {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['pendingUploadId', 'requestedAt'])
          && request.resource.data.pendingUploadId is string
          && request.resource.data.pendingUploadId.size() >= 1
          && request.resource.data.pendingUploadId.size() <= 64
          && request.resource.data.requestedAt is timestamp;
        allow delete: if false;
      }

      // private/account — server-written only (moderationStatus, reportCount, emailVerified)
      match /private/account {
        allow read: if signedIn() && request.auth.uid == userId;
        // Direct admin read removed: no Admin Dashboard component ever read
        // this document — confirmed via full-repo search. Confidential
        // moderation data must not remain directly readable by a stale
        // admin token merely because nothing currently exercises it.
        allow write: if false;
      }

      // private/preferences — owner read/write; strict field schema
      match /private/preferences {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
               'notificationRadius', 'notificationsEnabled', 'sharePreciseLocation',
               'lang', 'fcmToken'])
          && (!('notificationRadius' in request.resource.data)
               || (request.resource.data.notificationRadius is number
                   && request.resource.data.notificationRadius >= 0.1
                   && request.resource.data.notificationRadius <= 50))
          && (!('notificationsEnabled' in request.resource.data)
               || request.resource.data.notificationsEnabled is bool)
          && (!('sharePreciseLocation' in request.resource.data)
               || request.resource.data.sharePreciseLocation is bool)
          && (!('lang' in request.resource.data)
               || request.resource.data.lang in ['en', 'es'])
          && (!('fcmToken' in request.resource.data)
               || (request.resource.data.fcmToken is string
                   && request.resource.data.fcmToken.size() <= 4096));
      }

      // private/social — owner read/write; bounded blockedUsers list
      match /private/social {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['blockedUsers'])
          && request.resource.data.blockedUsers is list
          && request.resource.data.blockedUsers.size() <= 500;
      }

      // private/profile — owner-only demographic data (dob, gender, homeArea, etc.)
      match /private/profile {
        allow read, write: if signedIn() && request.auth.uid == userId;
        // Direct admin read removed: no Admin Dashboard component ever read
        // this document — confirmed via full-repo search. Private
        // demographic data must not remain directly readable by a stale
        // admin token merely because nothing currently exercises it.
      }
    }

    match /userLocations/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastGeohash', 'lastGeohashUpdatedAt'])
        && request.resource.data.lastGeohash is string
        && request.resource.data.lastGeohash.size() >= 1
        && request.resource.data.lastGeohash.size() <= 12
        && request.resource.data.lastGeohashUpdatedAt is timestamp
        && request.resource.data.lastGeohashUpdatedAt >= request.time - duration.value(5, 'm')
        && request.resource.data.lastGeohashUpdatedAt <= request.time + duration.value(1, 'm');
    }

    match /spots/{spotId} {
      // Public-ish: available/interested spots are readable by any signed-in user (live Ping feed).
      // Occupied/history spots are private: only the finder or active claimer may read them directly.
      // isAdmin() removed: it granted a genuine admin-specific escalation
      // (reading any other user's private occupied/history spot), consumed
      // only by PingsPage.tsx's "all pings" view — now the requireCurrentAdmin
      // -gated adminReadView('pingsList') callable, so a stale admin token no
      // longer retains this capability directly.
      allow read: if signedIn() && (
        resource.data.status == 'available'
        || resource.data.status == 'interested'
        || resource.data.finderId == request.auth.uid
        || resource.data.get('interestedUserId', null) == request.auth.uid
        || resource.data.get('claimedBy', null) == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
             'lat', 'lng', 'type', 'status', 'finderId', 'finderName',
             'pingMode', 'reportedAt', 'expiresAt', 'geohash', 'address'])
        && request.resource.data.keys().hasOnly([
             'lat', 'lng', 'type', 'status', 'finderId', 'finderName',
             'finderTitle', 'finderVehicleColor', 'finderVehicleType', 'finderVehicleBrand',
             'pingMode', 'reportedAt', 'expiresAt', 'geohash', 'address', 'originSpotId', 'source'])
        && request.resource.data.finderId == request.auth.uid
        && request.resource.data.status == 'available'
        && request.resource.data.type == 'free'
        && request.resource.data.finderName is string
        && request.resource.data.finderName.size() > 0
        && request.resource.data.finderName.size() <= 100
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && request.resource.data.pingMode in ['now', 'later']
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // 'source' is also written server-side (adminDeleteSpot sets 'admin'
        // via the Admin SDK, bypassing rules entirely) to drive
        // updateTrustOnSpotDelete's cancellation-penalty exemption — a client
        // create may NEVER set anything but the literal 'my_car' tag used for
        // handleMyCarPing's own orphan-cleanup filter, so this can't be used
        // to spoof the admin exemption.
        && (!('source' in request.resource.data) || request.resource.data.source == 'my_car')
        && matchesFinderIdentity(request.resource.data);
      allow delete: if signedIn() && resource.data.finderId == request.auth.uid;
      allow update: if signedIn() && (

        // Arm 1: Claim an available spot (immediate or scheduled)
        (isAvailableForClaim()
          && request.resource.data.interestedUserId == request.auth.uid
          && request.resource.data.status == 'interested'
          && matchesInterestedUserIdentity(request.resource.data)
          && onlyChanges(['status', 'claimState', 'ownerLeavingNow', 'ownerLeavingNowAt',
                          'interestedUserId', 'interestedUserName',
                          'interestedUserVehicleColor', 'interestedUserVehicleType',
                          'interestedUserVehicleBrand', 'interestedUserTitle',
                          'etaMinutes', 'interestExpiresAt', 'claimStartedAt',
                          'claimReminderAt', 'claimReminderSentAt',
                          'claimAutoReleaseAt', 'claimAutoReleasedAt']))

        // Arm 2: Claimer updates ETA
        || (isClaimer() && onlyChanges(['etaMinutes']))

        // Arm 2b: Claimer commits to heading (scheduled → active)
        || (isClaimer()
          && request.resource.data.status == 'interested'
          && onlyChanges(['claimState', 'ownerLeavingNow', 'ownerLeavingNowAt',
                          'etaMinutes', 'interestExpiresAt',
                          'claimReminderAt', 'claimReminderSentAt', 'claimAutoReleaseAt']))

        // Arm 3: Claimer cancels — clears all claimer metadata, Ping reopens.
        // Only valid while the Ping itself hasn't expired yet (an expired Ping
        // must never be reopened to 'available' — see Arm 3b for that case).
        || (isClaimer()
          && request.resource.data.status == 'available'
          && (resource.data.get('expiresAt', null) == null
              || resource.data.expiresAt > request.time)
          && onlyChanges(['status', 'claimState', 'ownerLeavingNow', 'ownerLeavingNowAt',
                          'interestedUserId', 'interestedUserName',
                          'interestedUserVehicleColor', 'interestedUserVehicleType',
                          'interestedUserVehicleBrand', 'interestedUserTitle',
                          'etaMinutes', 'interestExpiresAt', 'claimStartedAt',
                          'claimReminderAt', 'claimReminderSentAt',
                          'claimAutoReleaseAt', 'claimAutoReleasedAt']))

        // Arm 3b: Claimer cancels a claim on an already-expired Ping — clears
        // claimer metadata but leaves status untouched (never reopens it).
        || (isClaimer()
          && resource.data.get('expiresAt', null) != null
          && resource.data.expiresAt <= request.time
          && onlyChanges(['claimState', 'ownerLeavingNow', 'ownerLeavingNowAt',
                          'interestedUserId', 'interestedUserName',
                          'interestedUserVehicleColor', 'interestedUserVehicleType',
                          'interestedUserVehicleBrand', 'interestedUserTitle',
                          'etaMinutes', 'interestExpiresAt', 'claimStartedAt',
                          'claimReminderAt', 'claimReminderSentAt',
                          'claimAutoReleaseAt', 'claimAutoReleasedAt']))

        // Arm 4: Claimer marks arrived
        || (isClaimer()
          && request.resource.data.status == 'occupied'
          && onlyChanges(['status']))

        // Arm 5: Finder confirms arrival
        || (isFinder()
          && request.resource.data.status == 'occupied'
          && onlyChanges(['status']))

        // Arm 6: Finder extends claim expiry
        || (isFinder() && onlyChanges(['interestExpiresAt']))

        // Arm 6b: Finder signals they are leaving now (scheduled handoff)
        || (isFinder() && onlyChanges(['ownerLeavingNow', 'ownerLeavingNowAt', 'claimAutoReleaseAt']))

        // Arm 7: Finder accepts hold — old state must be pending, claimedBy must match requester
        || (isFinder()
          && resource.data.holdRequestStatus == 'pending'
          && resource.data.status == 'available'
          && resource.data.get('holdRequestedBy', null) != null
          && request.resource.data.holdRequestStatus == 'accepted'
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedBy == resource.data.holdRequestedBy
          && onlyChanges(['holdRequestStatus', 'status', 'claimedBy', 'holdTimerExpiresAt']))

        // Arm 8: Finder declines hold — old state must be pending
        || (isFinder()
          && resource.data.holdRequestStatus == 'pending'
          && resource.data.status == 'available'
          && request.resource.data.holdRequestStatus == 'declined'
          && request.resource.data.status == 'available'
          && request.resource.data.get('claimedBy', null) == null
          && onlyChanges(['holdRequestStatus', 'status', 'claimedBy']))

        // Arm 9: Send hold request — available spot, no active claim or hold
        || (isAvailableForHold()
          && request.resource.data.holdRequestedBy == request.auth.uid
          && request.resource.data.holdRequestStatus == 'pending'
          && matchesHoldRequesterIdentity(request.resource.data)
          && onlyChanges(['holdRequestedBy', 'holdRequestedByName',
                          'holdRequestStatus', 'holdRequestExpiresAt']))

        // Arm 10: Hold claimer arrival release
        || (isHoldClaimer()
          && request.resource.data.holdRequestStatus == 'completed'
          && request.resource.data.status == 'occupied'
          && onlyChanges(['holdRequestStatus', 'status']))

        // Arm 11: Hold timer expiry — old state must be accepted; finder or claimer may execute
        || ((isFinder() || isHoldClaimer())
          && resource.data.holdRequestStatus == 'accepted'
          && resource.data.status == 'claimed'
          && request.resource.data.holdRequestStatus == 'declined'
          && request.resource.data.status == 'available'
          && request.resource.data.get('claimedBy', null) == null
          && onlyChanges(['holdRequestStatus', 'status', 'claimedBy']))
      );
    }

    match /listings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    match /stats/{docId} {
      // Direct admin read removed: never read by any client — confirmed via
      // full-repo search.
      allow read: if false;
      allow write: if false;
    }

    match /avatarModeration/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /emailVerificationCodes/{userId} {
      allow read, write: if false;
    }

    match /usernames/{usernameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /moderationLog/{logId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(
             ['reporterId', 'reportedUserId', 'type', 'reason', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(
             ['reporterId', 'reportedUserId', 'type', 'reason', 'status',
              'conversationId', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.type in ['behavior', 'spam', 'inappropriate', 'other']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      // Direct admin read removed: the Admin Dashboard now reads reports
      // exclusively via the requireCurrentAdmin-gated adminReadView
      // ('reportsList'/'userDetail') callable — moderation data (reporter/
      // reported UIDs, free-text reasons) must not remain directly readable
      // by a stale admin token.
      allow read: if false;
      // Direct admin writes removed: the Admin Dashboard mutates reports
      // exclusively via the adminUpdateReport callable (requireCurrentAdmin).
      // No client code ever exercised this branch.
      allow update: if false;
    }

    match /spotNotifications/{notifId} {
      allow read: if signedIn()
        && (resource.data.targetUserId == request.auth.uid
          || (resource.data.senderId == request.auth.uid
            && resource.data.type == 'handoff_success'));
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(
             ['spotId', 'senderId', 'targetUserId', 'type', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(
             ['spotId', 'senderId', 'targetUserId', 'type', 'message', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.type in [
             'cancelled', 'claimer_cancelled', 'delayed',
             'handoff_success', 'owner_leaving_now']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt >= request.time - duration.value(5, 'm')
        && exists(/databases/$(database)/documents/spots/$(request.resource.data.spotId))
        && (
          (get(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data.finderId
               == request.auth.uid
            && get(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data
                 .get('interestedUserId', null) == request.resource.data.targetUserId)
          || (get(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data
                 .get('interestedUserId', null) == request.auth.uid
            && get(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data.finderId
                 == request.resource.data.targetUserId)
        );
      allow delete: if signedIn() && resource.data.targetUserId == request.auth.uid;
    }

    match /spotFeedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(
             ['spotId', 'userId', 'finderId', 'outcome', 'address', 'createdAt'])
        && request.resource.data.keys().hasOnly(
             ['spotId', 'userId', 'finderId', 'outcome', 'failureReason',
              'address', 'confirmedByFinder', 'createdAt'])
        && request.resource.data.spotId is string
        && request.resource.data.userId is string
        && request.resource.data.finderId is string
        && request.resource.data.outcome in ['success', 'failed']
        && (
          (request.resource.data.outcome == 'success'
            && request.resource.data.get('failureReason', null) == null)
          || (request.resource.data.outcome == 'failed'
            && ('failureReason' in request.resource.data)
            && (
              // Temporary rollout bridge: pre-#90 cached clients create an
              // explicit null; #90 clients create the final reason initially.
              // Feedback stays immutable. Remove after legacy clients retire
              // or a minimum-version/forced-refresh mechanism exists.
              request.resource.data.failureReason == null
              || request.resource.data.failureReason in [
                'Someone else got it',
                "Finder hadn't left yet",
                "Couldn't find the location",
                'Other'
              ]
            ))
        )
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt >= request.time - duration.value(5, 'm')
        && (
          (request.auth.uid == request.resource.data.userId
            && !('confirmedByFinder' in request.resource.data))
          || (request.auth.uid == request.resource.data.finderId
            && request.resource.data.confirmedByFinder == true
            && request.resource.data.outcome == 'success'
            && request.resource.data.failureReason == null)
        )
        && feedbackId == request.resource.data.spotId + '_' + request.resource.data.userId
        && exists(/databases/$(database)/documents/spots/$(request.resource.data.spotId))
        && getAfter(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data.status == 'occupied'
        && (
          (request.auth.uid == request.resource.data.userId
            && getAfter(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data
                 .get('interestedUserId', null) == request.auth.uid
            && getAfter(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data.finderId
                 == request.resource.data.finderId)
          || (request.auth.uid == request.resource.data.finderId
            && getAfter(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data.finderId
                 == request.auth.uid
            && getAfter(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data
                 .get('interestedUserId', null) == request.resource.data.userId)
        );
      // Direct admin read removed: never read by any Admin Dashboard
      // component — confirmed via full-repo search. Reads stay participant-only
      // so either side can safely reconcile its deterministic terminal retry.
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || (resource.data.finderId == request.auth.uid
            && resource.data.get('confirmedByFinder', false) == true));
      allow update, delete: if false;
    }

    match /accountDeletionJobs/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Marketing waitlist: written only by joinWaitlist/confirmWaitlist via the
    // Admin SDK. Holds email addresses and token hashes, so no client access at
    // all. See docs/WAITLIST.md.
    match /waitlist/{docId} {
      allow read, write: if false;
    }

    // Unsubscribe-token hashes for waitlist emails. No client SDK access, even
    // with an admin claim; the Functions use the Admin SDK, which bypasses Rules.
    match /waitlistUnsubscribeTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /adminBootstrap/{docId} {
      // Direct admin read removed: never read by any client — confirmed via
      // full-repo search. Admin identity/singleton-ownership data must not
      // remain directly readable by a stale admin token. bootstrapAdmin's own
      // transaction reads this via the Admin SDK, which bypasses Rules.
      allow read: if false;
      allow write: if false;
    }

    match /maintenanceJobs/{jobId} {
      allow read, write: if false;
    }

    match /adminAuditLog/{logId} {
      // Direct admin read removed: the Admin Dashboard now reads audit
      // history exclusively via the requireCurrentAdmin-gated adminReadView
      // ('auditLogList'/'userDetail') callable — a stale former admin must
      // not retain read access to privileged audit history.
      allow read: if false;
      allow write: if false;
    }

    match /parkingSessions/{userId} {
      // Direct admin read removed: it granted a genuine admin-specific
      // escalation (reading any other user's parking location/timing data),
      // consumed only by UsersPage.tsx's per-user detail view and
      // DashboardPage.tsx's active-session count — both now go through the
      // requireCurrentAdmin-gated adminReadView callable. Owner self-read
      // preserved.
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /parseFailures/{failureId} {
      // Direct admin read removed: the Admin Dashboard now reads parse
      // failures exclusively via the requireCurrentAdmin-gated adminReadView
      // ('parseFailuresList') callable. resolvedBy carries an admin's UID —
      // exposing admin identity via a stale token is exactly the class of
      // exposure this task closes.
      allow read: if false;
      // Signed-in users may create new failure docs or increment count on existing ones
      allow create: if signedIn();
      // Direct admin writes removed: adminResolveParseFailure/
      // adminReopenParseFailure (requireCurrentAdmin) are the only admin
      // mutation paths in the dashboard. No client code ever exercised the
      // isAdmin() branch here.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['count', 'lastSeenAt', 'location']);
      allow delete: if false;
    }

    // Canonical curb identities contain official GIS identifiers and resolver
    // evidence. They are Admin SDK/server-only; no client role can read or write.
    match /curbIdentities/{curbKey} {
      allow read, write: if false;
    }

    // All streetSegments/streetRules mutations are admin-callable-only
    // (adminAddSegment, adminUpdateSegmentStatus, adminAddCleaningRule,
    // adminSupersedeRule, adminBackfillStreetIntelligence — all
    // requireCurrentAdmin-gated). Direct client writes were previously
    // authorized here by token-only isAdmin(), which let a stale admin
    // token (demoted/deleted/disabled after the token was minted) keep
    // writing directly via utils/backfill.ts until the token expired,
    // regardless of how hardened the callables were. Firestore Rules
    // cannot re-verify current server-side Auth state, so the only fix is
    // removing direct client mutation capability entirely.
    match /streetSegments/{segmentId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /streetRules/{ruleId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }

    // Collection group rule required for collectionGroup('streetRules') queries.
    // Nested subcollection rules only cover path-based access, not cross-collection queries.
    match /{path=**}/streetRules/{ruleId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /suspensions/{suspensionId} {
      allow read: if true;
      // Direct admin writes removed: adminAddSuspension/adminArchiveSuspension
      // (requireCurrentAdmin) are the only mutation paths in the dashboard.
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if chatParticipant(resource.data);
      // lastMessage/lastMessageTimestamp/lastSenderId: authoritative-server-
      // owned via sendMessage (Admin SDK writes bypass these Rules).
      //
      // participantNames: REMOVED from the schema entirely. It was a
      // forgeable cache of the other participant's display name; the client
      // already does a live, always-overriding lookup of users/{uid}.
      // fullName (itself authoritative — see updateDisplayName) for every
      // conversation, so the cache was pure redundant attack surface with
      // no remaining purpose. See docs/CHAT_SHELL_METADATA_HARDENING.md.
      //
      // relatedSpotTitle: CREATE-ONCE. Legitimate app-generated context
      // (e.g. "Spot pinged by X") set once by the participant who starts
      // the conversation; no live source exists to re-derive it from later
      // (the originating spot may since have expired/been deleted), so it
      // is client-supplied at creation but immutable thereafter — never a
      // participant-editable field.
      //
      // Net effect: no field on an existing chats/{chatId} doc is directly
      // client-updatable at all anymore. initChat() (MessagesView.tsx) only
      // writes on first creation; re-navigating to an existing conversation
      // performs no write.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['id', 'participants'])
        && request.resource.data.keys().hasOnly(
             ['id', 'participants', 'relatedSpotTitle'])
        && request.resource.data.id == chatId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if false;
      // Direct client deletion disabled — deleteChat (functions/index.js) is
      // now the sole authoritative delete path: it re-verifies participant
      // membership, marks the chat `deleting` before any recursive removal
      // begins (closing the send/delete race), and recursively removes the
      // chat and its messages subcollection together via the Admin SDK,
      // which these Rules cannot see or gate. Allowing a direct client
      // delete here previously let a participant delete only the parent
      // chat doc without also deleting its messages, orphaning the
      // subcollection (Firestore does not cascade-delete subcollections).
      // See docs/CHAT_DELETE_HARDENING.md.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        );
        // Direct client create disabled — sendMessage (functions/index.js)
        // is now the sole authoritative write path: it re-verifies
        // membership and runs server-side moderation before writing via the
        // Admin SDK, which these Rules cannot see or gate. A client-side-
        // only check (the old rule below, and the still-present UX-only
        // moderateMessage()) is not a security boundary. See
        // docs/CHAT_MESSAGE_HARDENING.md.
        allow create: if false;
        allow update: if false;
        // Direct client deletion disabled — previously any chat participant
        // could delete an arbitrary individual message, including one sent
        // by the OTHER participant (this rule only checked chat membership,
        // never senderId). Deletion is now exclusively server-mediated via
        // deleteChat, alongside the whole conversation. See
        // docs/CHAT_DELETE_HARDENING.md.
        allow delete: if false;
      }
    }
  }
}
